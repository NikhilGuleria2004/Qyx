{
  "name": "qyx-api-gateway",
  "main": "apps/api-gateway/src/index.ts",
  "compatibility_date": "2025-08-14",
  "queues": {
    "producers": [
      {
        "binding": "OFFLINE_DELIVERY_QUEUE",
        "queue": "offline-delivery-dev"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "email-dev"
      },
      {
        "binding": "AUDIT_QUEUE",
        "queue": "audit-dev"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_DO",
        "class_name": "ConversationDO",
        "script_name": "qyx-api-gateway"
      },
      {
        "name": "CHANNEL_DO",
        "class_name": "ChannelDO",
        "script_name": "qyx-api-gateway"
      }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["ConversationDO", "ChannelDO"] }
  ]
}
