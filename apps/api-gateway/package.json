{
  "name": "@qyx/api-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy:dev": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate:dev": "wrangler d1 migrations apply qyx_primary_prod",
    "db:migrate:staging": "wrangler d1 migrations apply qyx_primary_staging --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply qyx_primary_prod --env production",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.0",
    "@qyx/schemas": "workspace:*",
    "@qyx/storage": "workspace:*",
    "aws4fetch": "^1.0.0",
    "hono": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "wrangler": "^4.124.0"
  }
}
